# Paste your Gemini API key below to activate Google Gemini generation (Primary).
# Get your key at: https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# Paste your Groq API key below to activate Groq generation (Fallback).
# Get your key at: https://console.groq.com/keys
# Note: You can define GROQ_API_KEY to keep it secure in the server environment (recommended),
# or define VITE_GROQ_API_KEY.
# Make sure to restart your Vite development server after changing this file!
GROQ_API_KEY=
VITE_GROQ_API_KEY=
